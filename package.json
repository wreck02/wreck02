{
  "name": "esat-mental-maths",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline, procedurally generated ESAT (Maths 1 / Maths 2 / Physics) mental-maths practice app",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sample": "vite-node scripts/sample.ts"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
